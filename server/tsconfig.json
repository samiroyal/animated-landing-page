{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",

    "target": "ES2022",
    "lib": ["ES2022"],

    "outDir": "../dist/server",

    "baseUrl": "..",
    "paths": {
      "@shared/*": ["shared/*"],
      "@/*": ["client/src/*"]
    },

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "types": ["node", "express"],
    "typeRoots": ["../node_modules/@types"]
  },
  "include": ["**/*.ts"]
}
